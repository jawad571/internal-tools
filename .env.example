# Newscast configuration. Every variable is optional; defaults are shown (commented values have no default).
# With no API keys set, the app runs fully offline: mock script writer, mock (tone) TTS, local audio storage.

# --- runtime ---
# development | test | production
NODE_ENV=development
# web = HTTP only, worker = ingest + generation only, all = both in one process
ROLE=all
PORT=8787
# Public origin used in podcast feed URLs (no trailing slash)
PUBLIC_URL=http://localhost:8787
# postgres://user:pass@host:5432/db in production; anything else is a PGlite data directory
DATABASE_URL=.data/pg
# true|false|1|0 — defaults to true when NODE_ENV=production
# COOKIE_SECURE=true

# --- script writing (LLM) ---
# Without a key, a deterministic mock writer is used.
# ANTHROPIC_API_KEY=
SCRIPT_MODEL=claude-sonnet-5-5

# --- text to speech ---
# openai | elevenlabs | mock. Default: elevenlabs if ELEVENLABS_API_KEY is set, else openai if OPENAI_API_KEY is set, else mock.
# ElevenLabs v4 is the most natural-sounding option. OpenAI's TTS models shut down on 2027-01-06.
# TTS_PROVIDER=
# OPENAI_API_KEY=
# gpt-4o-mini-tts accepts tone "instructions"; tts-1 / tts-1-hd do not.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# ELEVENLABS_API_KEY=
# eleven_v4 = highest quality. eleven_multilingual_v2 = older, cheaper fallback (no Urdu).
# Urdu bulletins use native Urdu voices from the Voice Library: they need a paid plan, and the key
# needs text-to-speech access (plus voices write access, if a voice has to be added to the account).
ELEVENLABS_MODEL=eleven_v4

# --- audio storage ---
# local | s3
STORAGE=local
# Used when STORAGE=local
STORAGE_DIR=.data/audio
# Used when STORAGE=s3. Credentials come from the standard AWS chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, instance role, etc.).
# S3_BUCKET=
# Defaults to "auto" (what Cloudflare R2 expects); set e.g. eu-west-2 for AWS.
# S3_REGION=
# Set for R2 / MinIO / other S3-compatible stores, e.g. https://<account>.r2.cloudflarestorage.com
# S3_ENDPOINT=

# --- video bulletins ---
# Render an MP4 (bulletin audio over story images, lower third, headline ticker) for users who
# turn on "Video bulletins". Uses the bundled ffmpeg-static binary; no system ffmpeg needed.
VIDEO_ENABLED=false
# ffmpeg renders at once per worker process (each one uses several cores)
VIDEO_CONCURRENCY=1
# Use a different ffmpeg binary instead of the bundled one
# FFMPEG_PATH=

# --- pipeline tuning ---
# Re-fetch a subscribed feed when its last fetch is older than this (failing feeds back off up to 64x)
INGEST_STALE_MINUTES=15
# Start generating this many minutes before the top of the hour so audio is ready on time
SCHEDULE_LEAD_MINUTES=12
# Editions generated concurrently per worker process
WORKER_CONCURRENCY=4
# Users inactive this long stop getting scheduled editions (on-demand still works)
IDLE_PAUSE_DAYS=7
# Editions and their audio/video older than this are deleted
RETENTION_DAYS=7
# Spoken words per minute (English) used to turn a target duration into a word budget.
# Other languages scale from this (Urdu = 160/150 of it; see SUPPORTED_LANGUAGES).
WORDS_PER_MINUTE=150
